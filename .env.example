# Example .env file for Instagram automation backend
# Copy this file to .env and fill in your real values

# n8n Authentication
N8N_BASIC_AUTH_USER=your_n8n_email@example.com
N8N_BASIC_AUTH_PASSWORD=your_n8n_password

# n8n Base URLs
N8N_EDITOR_BASE_URL=https://your-ngrok-url.ngrok-free.app
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app

# API Keys
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
CLAUDE_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key

# LiteLLM Model Configuration
PRIMARY_MODEL=claude-sonnet-4-20250514
FALLBACK_MODELS=gpt-4o,ollama/llama3.2

# Ollama (local fallback — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Enable community packages
N8N_COMMUNITY_PACKAGES_ENABLED=true
